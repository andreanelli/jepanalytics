{
  "data_root": "data/processed/pilot",
  "output_dir": "runs/pilot-summary-jepa-calibration-10k",
  "objective": "jepa",
  "epochs": 2,
  "batch_size": 24,
  "views_per_molecule": 5,
  "learning_rate": 0.0001,
  "weight_decay": 0.05,
  "mask_ratio": 0.5,
  "alignment_weight": 0.2,
  "alignment_temperature": 0.07,
  "alignment_clean_view": true,
  "alignment_uniformity_weight": 0.1,
  "alignment_target_std": 0.04,
  "summary_jepa_weight": 1.0,
  "ema_decay": 0.996,
  "variance_weight": 1.0,
  "initialize_from": "runs/pilot-jepa-multiview-mps/best.pt",
  "max_train_molecules": 10000,
  "seed": 17,
  "device": "mps",
  "log_every": 10,
  "checkpoint_every": 1,
  "wandb_enabled": true,
  "wandb_project": "jepanalytics",
  "wandb_run_id": "pilot-summary-jepa-calibration-10k-v1",
  "wandb_run_name": "10k global-summary JEPA calibration v1",
  "wandb_group": "chemistry-content-repair",
  "wandb_tags": [
    "calibration",
    "mps",
    "10k-molecules",
    "summary-jepa",
    "warm-start"
  ],
  "wandb_mode": "online",
  "encoder": {
    "n_bins": 4096,
    "patch_size": 32,
    "hidden_dim": 384,
    "depth": 12,
    "heads": 6,
    "mlp_ratio": 4.0,
    "aligned_dim": 256,
    "continuous_metadata_dim": 10,
    "dropout": 0.0
  }
