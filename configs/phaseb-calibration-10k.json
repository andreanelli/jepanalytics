  "max_train_molecules": 10000,
  "seed": 17,
  "device": "mps",
  "log_every": 10,
  "checkpoint_every": 1,
  "wandb_enabled": false,
  "encoder": {
    "n_bins": 4096,
    "patch_size": 32,
    "hidden_dim": 384,
    "depth": 12,
    "heads": 6,
    "mlp_ratio": 4.0,
