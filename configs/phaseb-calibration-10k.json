{
  "data_root": "data/processed/pilot-phaseb-10k",
  "output_dir": "runs/phaseb-calibration-10k",
  "objective": "jepa",
  "epochs": 2,
  "batch_size": 24,
  "views_per_molecule": 5,
  "learning_rate": 0.0001,
  "weight_decay": 0.05,
